{
    "layer": "top",
    "margin-top": 0,
    "margin-bottom": 2,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "height": 34,
    "position": "bottom",

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "custom/vpn",
        "battery",
        "pulseaudio"
    ],

    "modules-left": [
        "hyprland/workspaces",       
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false,
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "workspace-taskbar": {
            "enable": true,
            "format": "{icon}",
            "icon-size": 20,
            "tooltip-format": "{title}"
        }
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": " {:%I:%M %p}", 
        "format-alt": " {:%H:%M   %Y, %d %B, %A}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#ffffff'><b>{}</b></span>",
                "days":     "<span color='#b3e5fc'>{}</span>",
                "weeks":    "<span color='#00ff9f'><b>W{}</b></span>",
                "weekdays": "<span color='#00d7ff'><b>{}</b></span>",
                "today":    "<span color='#ffffff' background='#0078ff'><b><u>{}</u></b></span>"
            }
        }
    },

    "network": {
        "format-wifi" : "󰤢 {bandwidthDownBits}",
        "format-ethernet": "󰤢 {bandwidthDownBits}",
        "format-disconnected" : "󰤠 No Network",
        "interval": 5,
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": "󰂲 Apagado",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} 🔋{device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\n\nDispositivos:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  - {device_alias}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-icons": ["", "", " "],
        "nospacing": 1,
        "format-muted": " ",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "tooltip": true
    },

    "custom/vpn": {
        "format": "{}",
        "exec": "warp-cli status | grep -q 'Connected' && echo '🛡️✨ VPN' || echo '🛡️ VPN'",
        "interval": 2,
        "on-click": "warp-cli connect",
        "on-click-right": "warp-cli disconnect",
        "tooltip": false
    }
}
