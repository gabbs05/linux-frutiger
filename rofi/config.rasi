configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Oxygen";
    font: "Ubuntu 12";
    display-drun: "Buscador:";
}

* {
    /* Conversión de tus colores RGBA del CSS a Hexadecimal con Opacidad (Aero Glass) */
    transparente: #00000000;
    
    /* Fondo principal: rgba(0, 40, 80, 0.4) -> #00285066 */
    cristal-fondo: #00285066; 
    
    /* Bordes de cristal: rgba(255, 255, 255, 0.2) -> #ffffff33 */
    cristal-borde: #ffffff33; 
    
    /* Fondo del buscador: rgba(255, 255, 255, 0.1) -> #ffffff1a */
    cristal-input: #ffffff1a; 
    
    /* Efecto de selección brillante (reemplazo del gradiente) */
    seleccion-fondo: #0088ff66; 
    seleccion-borde: #ffffff66;
    
    /* Colores de texto */
    texto-normal: #ffffffcc;
    texto-seleccion: #ffffffff;

    /* Reglas globales */
    background-color: @transparente;
    text-color: @texto-normal;
}

window {
    width: 35%;
    location: north; /* Centrado en pantalla */
    border-radius: 20px;
    border: 1px;
    border-color: @cristal-borde;
    background-color: @cristal-fondo;
    padding: 15px;
}

mainbox {
    spacing: 10px;
    background-color: @transparente;
}

inputbar {
    background-color: @cristal-input;
    border-radius: 10px;
    border: 1px;
    border-color: @cristal-borde;
    padding: 10px;
    margin: 10px;
}

prompt, entry {
    text-color: @texto-seleccion;
    background-color: @transparente;
}

listview {
    background-color: @transparente;
    border-radius: 8px;
    padding: 10px;
    lines: 10;
}

element {
    padding: 8px;
    border-radius: 10px;
    background-color: @transparente;
}

element-text, element-icon {
    padding: 0px 8px 0px 0px;
    background-color: @transparente;
    text-color: inherit;
}

element selected {
    background-color: @seleccion-fondo;
    border: 1px;
    border-color: @seleccion-borde;
}

element-text selected {
    text-color: @texto-seleccion;
}
