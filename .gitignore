# =======================================================
# 1. Ignorar absolutamente todo en la raíz por defecto
# =======================================================
/*

# =======================================================
# 2. Excepciones principales (Permitir entrar a estas carpetas)
# =======================================================
!.gitignore
!.config/
!.local/
!.local/bin/
!.local/bin/**
# =======================================================
# 3. LISTA BLANCA DE .CONFIG
# =======================================================
# Ignorar todo el contenido de .config por defecto...
.config/*

# ...Y permitir SOLO las carpetas de nuestra interfaz:
!.config/hypr/
!.config/kitty/
!.config/waybar/
!.config/rofi/
!.config/swayosd/
!.config/wireplumber/
!.config/gtk-3.0/
!.config/gtk-4.0/
!.config/nwg-look/

# =======================================================
# 4. LISTA BLANCA DE .LOCAL
# =======================================================
# Ignorar todo el contenido de .local por defecto...
.local/*
# Excluir lanzador de Hubstaff del repo público
.local/share/applications/*hubstaff*

# ...Permitir entrar a share, pero ignorar su contenido...
!.local/share/
.local/share/*

# ...Y permitir SOLO los recursos visuales y sonoros:
!.local/share/sounds/
!.local/share/applications/
!.local/share/icons/
!.local/share/themes/

# Ignorar archivos de respaldo y temporales
*.save
*.bak
*~

# Ignorar base de datos de tipos MIME generada por el sistema
.local/share/applications/mimeinfo.cache

# Ignorar accesos directos de Wine y utilidades de terceros autogeneradas
.local/share/applications/wine*
.local/share/applications/wine/
.local/share/applications/com.raspberrypi.rpi-imager*

# Permitir únicamente la carpeta de iconos personalizados
!.local/share/icons/
!.local/share/icons/**
