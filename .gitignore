# =======================================================
# 1. Ignorar absolutamente todo en la raíz por defecto
# =======================================================
/*

# =======================================================
# 2. Archivos temporales, respaldos y cachés globales
# =======================================================
*.save
*.bak
*~
*.cache
mimeinfo.cache
icon-theme.cache

# =======================================================
# 3. Excepciones principales de primer nivel
# =======================================================
!.gitignore
!README.md
!.config/
!.local/

# =======================================================
# 4. LISTA BLANCA DE .CONFIG
# =======================================================
.config/*
!.config/hypr/
!.config/kitty/
!.config/waybar/
!.config/rofi/
!.config/swayosd/
!.config/wireplumber/
!.config/gtk-3.0/
!.config/gtk-4.0/
!.config/nwg-look/

# =======================================================
# 5. LISTA BLANCA DE .LOCAL
# =======================================================
.local/*

# Entrar a .local/bin pero permitir ÚNICAMENTE tus scripts (*.sh)
# (Ignora binarios pesados como uv, uvx, herramientas de python, etc.)
!.local/bin/
.local/bin/*
!.local/bin/*.sh

# Recursos en .local/share
!.local/share/
.local/share/*

# Sonidos y temas
!.local/share/sounds/
!.local/share/themes/

# Iconos: ignorar cachés y cualquier carpeta "apps" (Wine / sistema)
.local/share/icons/hicolor/icon-theme.cache
.local/share/icons/*/apps/
.local/share/icons/*/*/apps/
!.local/share/icons/

# Lanzadores (.desktop): ignorar basura del sistema y apps de terceros
!.local/share/applications/
.local/share/applications/mimeinfo.cache
.local/share/applications/*hubstaff*
.local/share/applications/wine*
.local/share/applications/wine/
.local/share/applications/com.raspberrypi.rpi-imager*
.local/share/applications/userapp-Firefox*
